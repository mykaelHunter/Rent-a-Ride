# Reference only - do NOT apply this file as-is. Never commit a real
# version of it. Same convention as k8s/secret-templates/*.example: this
# repo does not check in Secret manifests with placeholder values that a
# kubectl apply -f could accidentally bring live (see the remediation
# report, INC-036).
#
# Argo CD Image Updater needs push access to this git repo so it can
# commit the new image tag/digest into helm/rent-a-ride/values.yaml. A
# GitHub Personal Access Token (fine-grained, "Contents: Read and write"
# on this repo only) is the simplest credential to use here.
#
# Create the real Secret imperatively instead, e.g.:
#
#   kubectl create secret generic git-creds \
#     -n argocd \
#     --from-literal=username=<your-github-username> \
#     --from-literal=password=<your-fine-grained-PAT>
#
# The Application's write-back-method annotation
# (argocd-image-updater.argoproj.io/write-back-method: git:secret:argocd/git-creds)
# in argocd/applications/rent-a-ride.yaml references this Secret by name -
# keep the name in sync if you change it here.
apiVersion: v1
kind: Secret
metadata:
  name: git-creds
  namespace: argocd
type: Opaque
stringData:
  username: REPLACE_ME
  password: REPLACE_ME
