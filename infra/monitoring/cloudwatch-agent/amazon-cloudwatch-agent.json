{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "metrics": {
    "namespace": "RentARide/App",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}"
    },
    "aggregation_dimensions": [["InstanceId"], []],
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system",
          "cpu_usage_iowait"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent",
          "mem_used",
          "mem_total"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent",
          "used",
          "total",
          "inodes_free"
        ],
        "metrics_collection_interval": 60,
        "resources": ["/", "/var/lib/docker"],
        "ignore_file_system_types": ["sysfs", "devtmpfs", "tmpfs", "overlay"]
      },
      "diskio": {
        "measurement": ["reads", "writes", "read_bytes", "write_bytes", "io_time"],
        "metrics_collection_interval": 60,
        "resources": ["*"]
      },
      "net": {
        "measurement": ["bytes_sent", "bytes_recv", "packets_sent", "packets_recv", "drop_in", "drop_out"],
        "metrics_collection_interval": 60,
        "resources": ["eth0"]
      },
      "netstat": {
        "measurement": ["tcp_established", "tcp_time_wait"],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": ["swap_used_percent"],
        "metrics_collection_interval": 60
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/rent-a-ride/ec2/system-logs",
            "log_stream_name": "{instance_id}/syslog",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/auth.log",
            "log_group_name": "/rent-a-ride/ec2/system-logs",
            "log_stream_name": "{instance_id}/auth",
            "retention_in_days": 14
          },
          {
            "file_path": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log",
            "log_group_name": "/rent-a-ride/ec2/cwagent",
            "log_stream_name": "{instance_id}/cwagent",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/docker.log",
            "log_group_name": "/rent-a-ride/ec2/docker-daemon",
            "log_stream_name": "{instance_id}/docker",
            "retention_in_days": 14
          }
        ]
      }
    },
    "force_flush_interval": 15
  }
}
