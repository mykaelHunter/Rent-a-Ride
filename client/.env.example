# Copy this file to client/.env (or .env.local) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to browser code - see
# docs/incident-log.md (INC-018) for the RAZORPAY_KEY_ID variable, which
# is currently read without that prefix and will be undefined at runtime.

# Backend API base URL used by SignIn.jsx / Vehicles.jsx and, in dev, by
# vite.config.js's /api proxy target.
VITE_PRODUCTION_BACKEND_URL=http://localhost:3000

# Firebase Web API key (google sign-in). Other firebase.js config values
# (authDomain, projectId, etc.) are project identifiers, not secrets, and
# are left hardcoded in src/firebase.js.
VITE_FIREBASE_API_KEY=

# Razorpay publishable key, used client-side to open the checkout widget.
# NOTE: as of this file's writing the code reads this as
# import.meta.env.RAZORPAY_KEY_ID (missing the VITE_ prefix), so Vite will
# not actually expose it to the browser - see INC-018 in incident-log.md.
VITE_RAZORPAY_KEY_ID=
