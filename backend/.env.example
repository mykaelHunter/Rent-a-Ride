# Copy this file to backend/.env (or repo-root .env when running via
# `npm run dev`/`npm start` from the project root) and fill in real values.
# Never commit the real .env file - it's already in .gitignore.

# --- Server ---
# Port the Express server binds to. Most hosts (Render, Railway, Heroku...)
# inject their own PORT - leave this as a local-dev fallback.
PORT=3000

# Comma-separated list of origins allowed to call the API with credentials.
# Include your deployed frontend URL(s) and your local dev URL.
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.example

# --- Database ---
# MongoDB connection string (Atlas or self-hosted).
mongo_uri=mongodb://localhost:27017/rent-a-ride

# --- Auth (JWT) ---
# Long random secrets - do not reuse between ACCESS_TOKEN and REFRESH_TOKEN.
# e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN=
REFRESH_TOKEN=

# --- Cloudinary (vehicle image uploads) ---
CLOUD_NAME=
API_KEY=
API_SECRET=

# --- Email (nodemailer) ---
EMAIL_HOST=
EMAIL_PASSWORD=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
