# Used by docker-compose.yml for ${VAR} substitution when building the
# client image (Vite bakes these in at build time - see client/Dockerfile).
# Copy to .env at the repo root. Backend secrets live in backend/.env
# (see backend/.env.example) and client-only local dev in client/.env
# (see client/.env.example) - this file only needs to cover what
# docker-compose reads at build time.
VITE_PRODUCTION_BACKEND_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_RAZORPAY_KEY_ID=
