# REFERENCE ONLY - this file is NOT applied by kustomization.yaml and is
# not meant to be kubectl apply'd directly (note the .example extension).
#
# It exists purely to document the shape of the mongo-credentials Secret.
# The actual Secret must be created with the imperative command in the
# README's "Fresh install" section, using --from-literal, so a real
# generated password never sits in a file that could get applied by
# accident (which is exactly what happened previously: this Secret used
# to live inside 10-mongo-config.yaml with a Secret block AND ship in
# kustomization.yaml, so its checked-in REPLACE_ME placeholders became
# the live cluster values on first apply, and stayed that way until
# someone happened to notice actual auth failures).
apiVersion: v1
kind: Secret
metadata:
  name: mongo-credentials
  namespace: rent-a-ride
type: Opaque
stringData:
  MONGO_INITDB_ROOT_USERNAME: "REPLACE_ME"
  MONGO_INITDB_ROOT_PASSWORD: "REPLACE_ME"
