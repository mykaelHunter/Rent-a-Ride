# REFERENCE ONLY - this file is NOT applied by kustomization.yaml and is
# not meant to be kubectl apply'd directly (note the .example extension).
#
# It exists purely to document the shape of the backend-secret Secret -
# every key it needs, mirroring backend/.env.example plus mongo_uri.
# The actual Secret must be created with the imperative command in the
# README's "Fresh install" section, using --from-literal, so real
# credentials never sit in a file that could get applied by accident.
#
# mongo_uri MUST use the same username/password as mongo-credentials
# (see mongo-credentials.yaml.example) and the per-pod DNS name from the
# mongo headless Service - i.e.
#   mongodb://<user>:<url-encoded-password>@mongo-0.mongo.rent-a-ride.svc.cluster.local:27017/rent-a-ride?authSource=admin
# The password embedded here MUST be URL-encoded (unlike the raw value
# stored in mongo-credentials itself) - a generated password can contain
# URI-special characters (@, :, /, %, +) that break connection-string
# parsing with "MongoParseError: Password contains unescaped characters"
# if embedded raw. See the README's Fresh install section for the
# encoding command.
# Keep the two Secrets in sync by hand for now; an External Secrets
# Operator or Vault integration would remove this duplication if the
# credential ever needs to rotate.
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: rent-a-ride
type: Opaque
stringData:
  mongo_uri: "mongodb://REPLACE_ME_USER:REPLACE_ME_PASSWORD@mongo-0.mongo.rent-a-ride.svc.cluster.local:27017/rent-a-ride?authSource=admin"
  ACCESS_TOKEN: "REPLACE_ME"
  REFRESH_TOKEN: "REPLACE_ME"
  CLOUD_NAME: "REPLACE_ME"
  API_KEY: "REPLACE_ME"
  API_SECRET: "REPLACE_ME"
  EMAIL_HOST: "REPLACE_ME"
  EMAIL_PASSWORD: "REPLACE_ME"
  RAZORPAY_KEY_ID: "REPLACE_ME"
  RAZORPAY_SECRET: "REPLACE_ME"
